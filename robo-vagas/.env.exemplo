# Copie este arquivo para ".env" (sem o .exemplo) e preencha. Só serve para rodar no computador.
# O .env NÃO vai para o GitHub (está no .gitignore). No GitHub Actions, os mesmos nomes viram Secrets.

# Gmail novo que ENVIA o resumo da busca
GMAIL_USER=
# Senha de app do Google desse Gmail (16 letras). Crie em: myaccount.google.com/apppasswords (precisa da verificação em duas etapas ativa)
GMAIL_APP_PASSWORD=
NOME_REMETENTE=Robô de vagas

# Quem RECEBE o resumo (pode ser o mesmo Gmail ou outro e-mail). Vazio = não manda e-mail (o resumo fica só na issue do GitHub).
EMAIL_DESTINO=
